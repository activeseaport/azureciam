# Copy to .env and fill in values from the Entra External ID (CIAM) portal.
# Tenant subdomain only, e.g. "contoso" for contoso.ciamlogin.com
CIAM_TENANT_SUBDOMAIN=contoso
# Application (client) ID of an app registration with "Native authentication" enabled
CIAM_CLIENT_ID=00000000-0000-0000-0000-000000000000
# NOTE: no client secret. Native authentication must be called as a public
# client, so the app registration needs "Allow public client flows" = Yes.
# Space separated scopes
CIAM_SCOPES=openid offline_access
